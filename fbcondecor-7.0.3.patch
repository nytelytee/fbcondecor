+
+#ifdef CONFIG_FBCONDECOR
+
+/* fbcondecor.c */
+void fbcondecor_reset(void);
+int fbcondecor_init(void);
+extern bool fbcondecor_initialized_state;
+
+/* cfbcondecor.c */
+void fbcondecor_putcs(
+	struct vc_data *vc,
+	struct fb_info *info,
+	const u16 *character_source,
+	int character_count,
+	int row, int column,
+	int foreground_color_index,
+	int background_color_index
+);
+
+void fbcondecor_cursor(
+	struct fb_info *info,
+	struct fb_cursor *cursor
+);
+
+void fbcondecor_clear(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int start_row, int start_column,
+	int span_rows, int span_columns,
+	int foreground_color_index, int background_color_index
+);
+
+void fbcondecor_clear_margins(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int color_index,
+	int bottom_only
+);
+
+void fbcondecor_bmove_redraw(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int y,
+	int source_x,
+	int destination_x,
+	int width
+);
+
+
+/* utilities */
+static inline bool fbcondecor_active(struct fb_info *info, struct vc_data* vc) {
+	return (
+		fbcondecor_initialized_state &&
+		(vc->vc_fbcondecor_geometry || vc->vc_fbcondecor_image) &&
+		info->fix.visual == FB_VISUAL_TRUECOLOR &&
+		info->var.bits_per_pixel == 32
+	);
+}
+
+static inline u32 fbcondecor_get_color(struct fb_info *info, int index) {
+	return ((u32*) info->pseudo_palette)[index];
+}
+
+static inline u16 fbcondecor_offset_x(struct vc_data *vc) {
+	return vc->vc_fbcondecor_geometry ? vc->vc_fbcondecor_geometry->offset_x : 0;
+}
+
+static inline u16 fbcondecor_offset_y(struct vc_data *vc) {
+	return vc->vc_fbcondecor_geometry ? vc->vc_fbcondecor_geometry->offset_y : 0;
+}
+
+#else /* CONFIG_FBCONDECOR */
+
+/* fbcondecor.c */
+static inline int fbcondecor_init(void) { return 0; }
+static inline void fbcondecor_reset(void) {}
+#define fbcondecor_initialized_state false
+
+/* cfbcondecor.c */
+static inline void fbcondecor_putcs(
+	struct vc_data *vc,
+	struct fb_info *info,
+	const u16 *character_source,
+	int character_count,
+	int row, int column,
+	int foreground_color_index,
+	int background_color_index
+) {}
+
+static inline void fbcondecor_cursor(
+	struct fb_info *info,
+	struct fb_cursor *cursor
+) {}
+
+static inline void fbcondecor_clear(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int start_row, int start_column,
+	int span_rows, int span_columns,
+	int foreground_color_index, int background_color_index
+) {}
+static inline void fbcondecor_clear_margins(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int color_index,
+	int bottom_only
+) {}
+
+static inline void fbcondecor_bmove_redraw(
+	struct vc_data *vc,
+	struct fb_info *info,
+	int y,
+	int source_x,
+	int destination_x,
+	int width
+) {}
+
+/* utilities */
+static inline bool fbcondecor_active(
+	struct fb_info* info,
+	struct vc_data* vc
+) { return false; }
+
+static inline u32 fbcondecor_get_color(
+	struct fb_info *info,
+	int index
+) { return 0; }
+
+static inline u16 fbcondecor_offset_x(struct vc_data *vc) { return 0; }
+
+static inline u16 fbcondecor_offset_y(struct vc_data *vc) { return 0; }
+
+#endif /* CONFIG_FBCONDECOR */
+
+#endif /* __FBCONDECOR_H */
