diff -ruN old/drivers/video/console/cfbcondecor.c new/drivers/video/console/cfbcondecor.c
--- old/drivers/video/console/cfbcondecor.c	1970-01-01 01:00:00.000000000 +0100
+++ new/drivers/video/console/cfbcondecor.c	2026-05-03 05:47:27.035216148 +0200
@@ -0,0 +1,321 @@
+/*
+ *  linux/drivers/video/cfbcondecor.c -- Framebuffer decor render functions
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *  Copyright (C) 2026-2026 NyteLyte <nytelyte@tuta.io>
+ *
+ *  Original code based upon "Bootdecor" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ */
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/fb.h>
+#include <linux/selection.h>
+#include <linux/slab.h>
+#include <linux/vt_kern.h>
+#include <asm/irq.h>
+
+#include "../fbdev/core/fbcon.h"
+#include "fbcondecor.h"
+
+extern int get_color(struct vc_data *vc, struct fb_info *info,
+                     u16 c, bool is_fg);
+
+static void fbcondecor_renderc(struct fb_info *info, struct vc_data *vc, int ypos, int xpos, int height,
+                               int width, u8 *src, u32 fgx, u32 bgx, u8 transparent)
+{
+	if (!fbcondecor_initialized_state) return;
+	if (info->var.bits_per_pixel != 32) return;
+	unsigned int x, y;
+	u32 dd;
+
+	int bytespp = ((info->var.bits_per_pixel + 7) >> 3);
+	unsigned int d = ypos * info->fix.line_length + xpos * bytespp;
+	unsigned int ds = (ypos * info->var.xres + xpos) * bytespp;
+	
+	u8 *decor_src = NULL;
+	if (!vc->vc_fbcondecor_image)
+		transparent = false;
+	else
+		decor_src = vc->vc_fbcondecor_image + ds;
+
+	u8 *dst = (u8 *)(info->screen_base + d);
+
+	if ((ypos + height) > info->var.yres || (xpos + width) > info->var.xres)
+		return;
+
+	for (y = 0; y < height; y++) {
+		for (x = 0; x < width; x++) {
+
+			if ((x & 7) == 0)
+				d = *src++;
+			if (d & 0x80)
+				dd = fgx;
+			else
+				dd = transparent ? *(u32 *)decor_src : bgx;
+
+			d <<= 1;
+			if (transparent) decor_src += 4;
+			fb_writel(dd, dst);
+			dst += 4;
+		}
+
+		dst += info->fix.line_length - width * bytespp;
+		if (transparent) decor_src += (info->var.xres - width) * bytespp;
+	}
+}
+
+#define cc2cx(a) (((u32 *) info->pseudo_palette)[a])
+
+#define vc_tx(vc) (vc->vc_fbcondecor_geometry ? vc->vc_fbcondecor_geometry->offset_x : 0)
+#define vc_ty(vc) (vc->vc_fbcondecor_geometry ? vc->vc_fbcondecor_geometry->offset_y : 0)
+
+void fbcondecor_putcs(struct vc_data *vc, struct fb_info *info,
+                      const unsigned short *s, int count, int yy, int xx)
+{
+	if (!fbcondecor_initialized_state) return;
+	unsigned short charmask = vc->vc_hi_font_mask ? 0x1ff : 0xff;
+	struct fbcon_par *ops = info->fbcon_par;
+	int fg_color, bg_color, transparent;
+	u8 *src;
+	u32 bgx, fgx;
+
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	int vc_bg_color = attr_bgcol(bgshift, vc->vc_video_erase_char);
+
+	u16 c = scr_readw(s);
+
+	fg_color = get_color(vc, info, c, 1);
+	bg_color = get_color(vc, info, c, 0);
+
+	/* Don't paint the background image if console is blanked */
+	transparent = ops->blank_state ? 0 : (vc_bg_color == bg_color);
+
+	xx = xx * vc->vc_font.width + vc_tx(vc);
+	yy = yy * vc->vc_font.height + vc_ty(vc);
+
+	fgx = cc2cx(fg_color);
+	bgx = cc2cx(bg_color);
+
+	while (count--) {
+		c = scr_readw(s++);
+		src = vc->vc_font.data + (c & charmask) * vc->vc_font.height *
+		      ((vc->vc_font.width + 7) >> 3);
+
+		fbcondecor_renderc(info, vc, yy, xx, vc->vc_font.height,
+			       vc->vc_font.width, src, fgx, bgx, transparent);
+		xx += vc->vc_font.width;
+	}
+}
+
+void fbcondecor_cursor(struct fb_info *info, struct fb_cursor *cursor)
+{
+	if (!fbcondecor_initialized_state) return;
+	int i;
+	unsigned int dsize, s_pitch;
+	struct fbcon_par *ops = info->fbcon_par;
+	struct vc_data *vc;
+	u8 *src;
+
+	/* we really don't need any cursors while the console is blanked */
+	if (info->state != FBINFO_STATE_RUNNING || ops->blank_state)
+		return;
+
+	vc = vc_cons[ops->currcon].d;
+
+	src = kmalloc(64 + sizeof(struct fb_image), GFP_ATOMIC);
+	if (!src)
+		return;
+
+	s_pitch = (cursor->image.width + 7) >> 3;
+	dsize = s_pitch * cursor->image.height;
+	if (cursor->enable) {
+		switch (cursor->rop) {
+		case ROP_XOR:
+			for (i = 0; i < dsize; i++)
+				src[i] = cursor->image.data[i] ^ cursor->mask[i];
+			break;
+		case ROP_COPY:
+		default:
+			for (i = 0; i < dsize; i++)
+				src[i] = cursor->image.data[i] & cursor->mask[i];
+			break;
+		}
+	} else
+		memcpy(src, cursor->image.data, dsize);
+	
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	int vc_bg_color = attr_bgcol(bgshift, vc->vc_video_erase_char);
+
+	fbcondecor_renderc(info,
+			vc,
+			cursor->image.dy + vc_ty(vc),
+			cursor->image.dx + vc_tx(vc),
+			cursor->image.height,
+			cursor->image.width,
+			(u8 *)src,
+			cc2cx(cursor->image.fg_color),
+			cc2cx(cursor->image.bg_color),
+			cursor->image.bg_color == vc_bg_color);
+
+	kfree(src);
+}
+
+static void decorset(u8 *dst, int height, int width, int dstbytes,
+				u32 bgx)
+{
+	if (!fbcondecor_initialized_state) return;
+	int i;
+
+	while (height-- > 0) {
+		u8 *p = dst;
+		for (i = 0; i < width; i++) { fb_writel(bgx, p); p += 4; }
+		dst += dstbytes;
+	}
+}
+
+static void fbcondecor_copy(u8 *dst, u8 *src, int height, int width, int linebytes,
+                            int srclinebytes)
+{
+	if (!fbcondecor_initialized_state) return;
+	int i;
+	
+	while (height-- > 0) {
+		u32 *p = (u32 *)dst;
+		u32 *q = (u32 *)src;
+
+		for (i = 0; i < width; i++) fb_writel(*q++, p++);
+
+		dst += linebytes;
+		src += srclinebytes;
+	}
+}
+
+static void decorfill(struct fb_info *info, struct vc_data *vc, int sy, int sx, int height, int width)
+{
+	if (!fbcondecor_initialized_state) return;
+	int bytespp = ((info->var.bits_per_pixel + 7) >> 3);
+	int d = sy * info->fix.line_length + sx * bytespp;
+	u8 *dst = (u8 *)(info->screen_base + d);
+	
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	int vc_bg_color = attr_bgcol(bgshift, vc->vc_video_erase_char);
+
+	if (!vc->vc_fbcondecor_image) {
+		decorset(dst, height, width, info->fix.line_length,
+		         cc2cx(vc_bg_color));
+		return;
+	}
+
+	int ds = (sy * info->var.xres + sx) * bytespp;
+	fbcondecor_copy(dst, vc->vc_fbcondecor_image + ds,
+	                height, width, info->fix.line_length,
+	                info->var.xres * bytespp);
+}
+
+void fbcondecor_clear(struct vc_data *vc, struct fb_info *info, int sy, int sx,
+                      int height, int width)
+{
+	if (!fbcondecor_initialized_state) return;
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	struct fbcon_par *ops = info->fbcon_par;
+	u8 *dst;
+	//int transparent, bg_color = attr_bgcol_ec(bgshift, vc, info);
+	int transparent, bg_color = attr_bgcol(bgshift, vc->vc_video_erase_char);
+
+	transparent = true;
+	sy = sy * vc->vc_font.height + vc_ty(vc);
+	sx = sx * vc->vc_font.width + vc_tx(vc);
+	height *= vc->vc_font.height;
+	width *= vc->vc_font.width;
+
+	/* Don't paint the background image if console is blanked */
+	if (transparent && !ops->blank_state && vc->vc_fbcondecor_image) {
+		decorfill(info, vc, sy, sx, height, width);
+	} else {
+		dst = (u8 *)(info->screen_base + sy * info->fix.line_length +
+		             sx * ((info->var.bits_per_pixel + 7) >> 3));
+		decorset(dst, height, width, info->fix.line_length, cc2cx(bg_color));
+	}
+}
+
+void fbcondecor_clear_margins(struct vc_data *vc, struct fb_info *info,
+                              int bottom_only)
+{
+	if (!fbcondecor_initialized_state) return;
+	unsigned int tw = vc->vc_cols*vc->vc_font.width;
+	unsigned int th = vc->vc_rows*vc->vc_font.height;
+
+	if (!bottom_only) {
+		/* top margin */
+		decorfill(info, vc, 0, 0, vc_ty(vc), info->var.xres);
+		/* left margin */
+		decorfill(info, vc, vc_ty(vc), 0, th, vc_tx(vc));
+		/* right margin */
+		decorfill(info, vc, vc_ty(vc), vc_tx(vc) + tw, th,
+			   info->var.xres - vc_tx(vc) - tw);
+	}
+	decorfill(info, vc, vc_ty(vc) + th, 0,
+		   info->var.yres - vc_ty(vc) - th, info->var.xres);
+}
+
+void fbcondecor_bmove_redraw(struct vc_data *vc, struct fb_info *info, int y,
+			   int sx, int dx, int width)
+{
+	if (!fbcondecor_initialized_state) return;
+	u16 *d = (u16 *) (vc->vc_origin + vc->vc_size_row * y + dx * 2);
+	u16 *s = d + (dx - sx);
+	u16 *start = d;
+	u16 *ls = d;
+	u16 *le = d + width;
+	u16 c;
+	int x = dx;
+	u16 attr = 1;
+
+	do {
+		c = scr_readw(d);
+		if (attr != (c & 0xff00)) {
+			attr = c & 0xff00;
+			if (d > start) {
+				fbcondecor_putcs(vc, info, start, d - start, y, x);
+				x += d - start;
+				start = d;
+			}
+		}
+		if (s >= ls && s < le && c == scr_readw(s)) {
+			if (d > start) {
+				fbcondecor_putcs(vc, info, start, d - start, y, x);
+				x += d - start + 1;
+				start = d + 1;
+			} else {
+				x++;
+				start++;
+			}
+		}
+		s++;
+		d++;
+	} while (d < le);
+	if (d > start)
+		fbcondecor_putcs(vc, info, start, d - start, y, x);
+}
+
+void fbcondecor_blank(struct vc_data *vc, struct fb_info *info, int blank)
+{
+	if (!fbcondecor_initialized_state) return;
+	if (blank) {
+		decorset((u8 *)info->screen_base, info->var.yres, info->var.xres,
+			  info->fix.line_length, 0);
+	} else {
+		update_screen(vc);
+		fbcondecor_clear_margins(vc, info, 0);
+	}
+}
+
