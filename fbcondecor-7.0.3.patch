diff -ruN oldlinux/drivers/video/fbdev/core/cfbcondecor.c newlinux/drivers/video/fbdev/core/cfbcondecor.c
--- oldlinux/drivers/video/fbdev/core/cfbcondecor.c	1970-01-01 01:00:00.000000000 +0100
+++ newlinux/drivers/video/fbdev/core/cfbcondecor.c	2026-05-09 00:29:38.901362600 +0200
@@ -0,0 +1,391 @@
+/*
+ *  linux/drivers/video/fbdev/core/cfbcondecor.c -- Framebuffer decor render functions
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *  Copyright (C) 2026-2026 NyteLyte <nytelyte@tuta.io>
+ *
+ *  Original code based upon "Bootdecor" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ */
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/fb.h>
+#include <linux/selection.h>
+#include <linux/slab.h>
+#include <linux/vt_kern.h>
+#include <asm/irq.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+static inline void fbcondecor_fill_image(
+	u8 *destination, int destination_line_bytes,
+	u8 *source, int source_line_bytes,
+	int area_height, int area_width
+) {
+
+	while (area_height-- > 0) {
+		u32 *destination_line = (u32 *)destination;
+		u32 *source_line = (u32 *)source;
+
+		for (int i = 0; i < area_width; i++) {
+			fb_writel(*source_line++, destination_line++);
+		}
+
+		destination += destination_line_bytes;
+		source += source_line_bytes;
+	}
+}
+
+static inline void fbcondecor_fill_color(
+	u8 *destination, int destination_line_bytes,
+	u32 color, int area_height, int area_width
+) {
+
+	while (area_height-- > 0) {
+		u32 *destination_line = (u32 *)destination;
+
+		for (int i = 0; i < area_width; i++) {
+			fb_writel(color, destination_line++);
+		}
+
+		destination += destination_line_bytes;
+	}
+}
+
+static void fbcondecor_fill(struct fb_info *info, struct vc_data *vc,
+                            int offset_y, int offset_x,
+                            int height, int width, int color_index)
+{
+	if (!fbcondecor_initialized_state) return;
+	const int bytes_per_pixel = 4; // we only support 32bpp true color
+	int destination_offset = offset_y*info->fix.line_length + offset_x*bytes_per_pixel;
+	u8 *destination = (u8 *)(info->screen_base + destination_offset);
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+	
+	if (
+		info->fbcon_par->blank_state ||
+		color_index != vc_background_color_index ||
+		!vc->vc_fbcondecor_image
+	) {
+		fbcondecor_fill_color(destination, info->fix.line_length,
+		                      fbcondecor_get_color(info, color_index), height, width);
+	} else {
+		int source_offset = (offset_y*info->var.xres + offset_x)*bytes_per_pixel;
+		u8* source = vc->vc_fbcondecor_image + source_offset;
+		fbcondecor_fill_image(destination, info->fix.line_length,
+		                      source, info->var.xres*bytes_per_pixel,
+		                      height, width);
+	}
+}
+
+static void fbcondecor_putc_atop_image(
+	struct fb_info *info, struct vc_data *vc,
+	int offset_y, int offset_x,
+	int height, int width,
+	u8 *character, u32 foreground_color
+)
+{
+	const int bytes_per_pixel = 4;
+	
+	int destination_offset = offset_y*info->fix.line_length + offset_x*bytes_per_pixel;
+	int source_offset = (offset_y*info->var.xres + offset_x)*bytes_per_pixel;
+
+	u8 *source = vc->vc_fbcondecor_image + source_offset;
+	u8 *destination = info->screen_base + destination_offset;
+	
+	if (offset_y + height > info->var.yres) return;
+	if (offset_x + width > info->var.xres) return;
+
+	u8 current_character_part;
+	for (int y = 0; y < height; y++) {
+		for (int x = 0; x < width; x++) {
+			if ((x & 7) == 0) current_character_part = *character++;
+			fb_writel(
+				(current_character_part & 0b10000000) ? foreground_color : *(u32 *)source,
+				destination
+			);
+			current_character_part <<= 1;
+			destination += bytes_per_pixel;
+			source += bytes_per_pixel;
+		}
+		destination += info->fix.line_length - width*bytes_per_pixel;
+		source += (info->var.xres - width) * bytes_per_pixel;
+
+	}
+}
+
+static void fbcondecor_putc_atop_color(
+	struct fb_info *info, struct vc_data *vc,
+	int offset_y, int offset_x,
+	int height, int width,
+	u8 *character, u32 foreground_color, u32 background_color
+)
+{
+	int bytes_per_pixel = 4;
+	
+	int destination_offset = offset_y*info->fix.line_length + offset_x*bytes_per_pixel;
+	u8 *destination = info->screen_base + destination_offset;
+	
+	if (offset_y + height > info->var.yres) return;
+	if (offset_x + width > info->var.xres) return;
+
+	u8 current_character_part;
+	for (int y = 0; y < height; y++) {
+		for (int x = 0; x < width; x++) {
+			if ((x & 7) == 0) current_character_part = *character++;
+			fb_writel(
+				(current_character_part & 0b10000000) ? foreground_color : background_color,
+				destination
+			);
+			current_character_part <<= 1;
+			destination += bytes_per_pixel;
+		}
+		destination += info->fix.line_length - width*bytes_per_pixel;
+
+	}
+}
+
+
+void fbcondecor_putcs(struct vc_data *vc, struct fb_info *info,
+                      const u16 *character_source, int character_count,
+                      int row, int column,
+                      int foreground_color_index,
+                      int background_color_index)
+{
+	if (!fbcondecor_initialized_state) return;
+	u16 charmask = vc->vc_hi_font_mask ? 0x1ff : 0xff;
+	u32 foreground_color, background_color;
+	u16 character;
+	u8 *character_data;
+
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+
+	int x_offset = column * vc->vc_font.width + fbcondecor_offset_x(vc);
+	int y_offset = row * vc->vc_font.height + fbcondecor_offset_y(vc);
+
+	foreground_color = fbcondecor_get_color(info, foreground_color_index);
+	
+	if (
+		info->fbcon_par->blank_state ||
+		background_color_index != vc_background_color_index ||
+		!vc->vc_fbcondecor_image
+	) {
+		background_color = fbcondecor_get_color(info, background_color_index);
+		while (character_count--) {
+			character = scr_readw(character_source++);
+			character_data = vc->vc_font.data + (character & charmask) *
+			                 vc->vc_font.height *
+			                 ((vc->vc_font.width + 7) >> 3);
+			fbcondecor_putc_atop_color(
+				info, vc, y_offset, x_offset,
+				vc->vc_font.height, vc->vc_font.width,
+				character_data, foreground_color, background_color
+			);
+			x_offset += vc->vc_font.width;
+		}
+	} else {
+		while (character_count--) {
+			character = scr_readw(character_source++);
+			character_data = vc->vc_font.data + (character & charmask) *
+			                 vc->vc_font.height *
+			                 ((vc->vc_font.width + 7) >> 3);
+			fbcondecor_putc_atop_image(
+				info, vc, y_offset, x_offset,
+				vc->vc_font.height, vc->vc_font.width,
+				character_data, foreground_color
+			);
+			x_offset += vc->vc_font.width;
+		}
+
+	}
+}
+
+void fbcondecor_cursor(struct fb_info *info, struct fb_cursor *cursor)
+{
+	if (!fbcondecor_initialized_state) return;
+	int i;
+	unsigned int dsize, s_pitch;
+	struct fbcon_par *ops = info->fbcon_par;
+	struct vc_data *vc;
+	u8 *src;
+
+	/* we really don't need any cursors while the console is blanked */
+	if (info->state != FBINFO_STATE_RUNNING || ops->blank_state)
+		return;
+
+	vc = vc_cons[ops->currcon].d;
+
+	s_pitch = (cursor->image.width + 7) >> 3;
+	dsize = s_pitch * cursor->image.height;
+	src = kmalloc(dsize, GFP_ATOMIC);
+	if (!src)
+		return;
+
+	if (cursor->enable) {
+		switch (cursor->rop) {
+		case ROP_XOR:
+			for (i = 0; i < dsize; i++)
+				src[i] = cursor->image.data[i] ^ cursor->mask[i];
+			break;
+		case ROP_COPY:
+		default:
+			for (i = 0; i < dsize; i++)
+				src[i] = cursor->image.data[i] & cursor->mask[i];
+			break;
+		}
+	} else
+		memcpy(src, cursor->image.data, dsize);
+	
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+
+	if (
+		cursor->image.bg_color != vc_background_color_index ||
+		!vc->vc_fbcondecor_image
+	) {
+		fbcondecor_putc_atop_color(
+			info, vc,
+			cursor->image.dy + fbcondecor_offset_y(vc),
+			cursor->image.dx + fbcondecor_offset_x(vc),
+			cursor->image.height,
+			cursor->image.width,
+			src,
+			fbcondecor_get_color(info, cursor->image.fg_color),
+			fbcondecor_get_color(info, cursor->image.bg_color)
+		);
+	} else {
+		fbcondecor_putc_atop_image(
+			info, vc,
+			cursor->image.dy + fbcondecor_offset_y(vc),
+			cursor->image.dx + fbcondecor_offset_x(vc),
+			cursor->image.height,
+			cursor->image.width,
+			src,
+			fbcondecor_get_color(info, cursor->image.fg_color)
+		);
+	}
+
+	kfree(src);
+}
+
+
+void fbcondecor_clear(struct vc_data *vc, struct fb_info *info,
+                      int start_row, int start_column,
+                      int span_rows, int span_columns,
+                      int foreground_color_index, int background_color_index)
+{
+	if (!fbcondecor_initialized_state) return;
+
+	int offset_y = start_row * vc->vc_font.height + fbcondecor_offset_y(vc);
+	int offset_x = start_column * vc->vc_font.width + fbcondecor_offset_x(vc);
+
+	int height = span_rows * vc->vc_font.height;
+	int width = span_columns * vc->vc_font.width;
+
+	fbcondecor_fill(info, vc,
+	                offset_y, offset_x,
+	                height, width, background_color_index);
+}
+
+void fbcondecor_clear_margins(struct vc_data *vc, struct fb_info *info,
+                              int color_index, int bottom_only)
+{
+	if (!fbcondecor_initialized_state) return;
+	unsigned int vc_width = vc->vc_cols*vc->vc_font.width;
+	unsigned int vc_height = vc->vc_rows*vc->vc_font.height;
+
+	if (!bottom_only) {
+		/* top margin */
+		fbcondecor_fill(info, vc,
+		                0, 0,
+		                fbcondecor_offset_y(vc), info->var.xres,
+		                color_index);
+		/* left margin */
+		fbcondecor_fill(info, vc,
+		                fbcondecor_offset_y(vc), 0,
+		                vc_height, fbcondecor_offset_x(vc),
+		                color_index);
+		/* right margin */
+		fbcondecor_fill(info, vc,
+		                fbcondecor_offset_y(vc), fbcondecor_offset_x(vc) + vc_width,
+		                vc_height, info->var.xres - fbcondecor_offset_x(vc) - vc_width,
+		                color_index);
+	}
+	fbcondecor_fill(info, vc,
+	                fbcondecor_offset_y(vc) + vc_height, 0,
+	                info->var.yres - fbcondecor_offset_y(vc) - vc_height, info->var.xres,
+	                color_index);
+}
+
+void fbcondecor_bmove_redraw(struct vc_data *vc, struct fb_info *info, int y,
+                             int source_x, int destination_x, int width)
+{
+	if (!fbcondecor_initialized_state) return;
+	u16 *destination = (u16 *) (vc->vc_origin + vc->vc_size_row*y + destination_x*2);
+	u16 *source = destination + (destination_x - source_x);
+	u16 *current_run = destination;
+
+	u16 *line_start = destination;
+	u16 *line_end = destination + width;
+	u16 character;
+	int current_x = destination_x;
+
+	u16 current_attribute = 1;
+	u16 attrmask = vc->vc_hi_font_mask ? 0xfe00 : 0xff00;
+
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	int fgshift = (vc->vc_hi_font_mask) ? 9 : 8;
+
+	do {
+		character = scr_readw(destination);
+		// we send only runs of characters with the same attributes to putcs
+		if (current_attribute != (character & attrmask)) {
+			int foreground_color_index = attr_fgcol(fgshift, current_attribute);
+			int background_color_index = attr_bgcol(bgshift, current_attribute);
+			current_attribute = character & attrmask;
+			if (destination > current_run) {
+
+				fbcondecor_putcs(
+					vc, info, current_run, destination - current_run, y, current_x,
+					foreground_color_index, background_color_index
+				);
+				current_x += destination - current_run;
+				current_run = destination;
+			}
+		}
+		// if a character would have been the same anyway, we don't change it
+		if (source >= line_start && source < line_end && character == scr_readw(source)) {
+			int foreground_color_index = attr_fgcol(fgshift, current_attribute);
+			int background_color_index = attr_bgcol(bgshift, current_attribute);
+			if (destination > current_run) {
+				fbcondecor_putcs(
+					vc, info, current_run, destination - current_run, y, current_x,
+					foreground_color_index, background_color_index
+				);
+				current_x += destination - current_run + 1;
+				current_run = destination + 1;
+			} else {
+				current_x++;
+				current_run++;
+			}
+		}
+		source++;
+		destination++;
+	} while (destination < line_end);
+	if (destination > current_run) {
+		int foreground_color_index = attr_fgcol(fgshift, current_attribute);
+		int background_color_index = attr_bgcol(bgshift, current_attribute);
+		fbcondecor_putcs(
+			vc, info, current_run, destination - current_run, y, current_x,
+			foreground_color_index, background_color_index
+		);
+	}
+}
