diff -ruN oldlinux/drivers/video/fbdev/core/cfbcondecor.c newlinux/drivers/video/fbdev/core/cfbcondecor.c
--- oldlinux/drivers/video/fbdev/core/cfbcondecor.c	1970-01-01 01:00:00.000000000 +0100
+++ newlinux/drivers/video/fbdev/core/cfbcondecor.c	2026-05-11 02:24:39.105880164 +0200
@@ -0,0 +1,550 @@
+/*
+ *  linux/drivers/video/fbdev/core/cfbcondecor.c -- Framebuffer decor render
+ *                                                  functions
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *  Copyright (C) 2026-2026 NyteLyte <nytelyte@tuta.io>
+ *
+ *  Original code based upon "Bootdecor" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ */
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/fb.h>
+#include <linux/selection.h>
+#include <linux/slab.h>
+#include <linux/vt_kern.h>
+#include <asm/irq.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+struct screen_draw_info {
+	int start_position;
+	int next_pixel_offset;
+	int next_line_offset;
+};
+
+static inline struct screen_draw_info get_draw_info(
+	int rotation,
+	int resolution_x, int resolution_y,
+	int offset_x, int offset_y,
+	int bytes_per_pixel, int bytes_per_line
+) {
+	switch (rotation) {
+		case FB_ROTATE_CW:
+			// Top right corner is (0 lines, xres-1 pixels).
+			// x offset translates to a positive offset in lines.
+			// y offset translates to a negative offset in pixels.
+			return (struct screen_draw_info){
+				.start_position = (
+					0*bytes_per_line +
+					(resolution_x - 1)*bytes_per_pixel +
+					offset_x*bytes_per_line +
+					-offset_y*bytes_per_pixel
+				),
+				.next_pixel_offset = bytes_per_line,
+				.next_line_offset = -bytes_per_pixel
+
+			};
+		case FB_ROTATE_UD:
+			// Bottom right corner is (yres-1 lines, xres-1 pixels)
+			// x offset translates to a negative offset in pixels.
+			// y offset translates to a negative offset in lines.
+			return (struct screen_draw_info){
+				.start_position = (
+					(resolution_y - 1)*bytes_per_line +
+					(resolution_x - 1)*bytes_per_pixel +
+					-offset_x*bytes_per_pixel +
+					-offset_y*bytes_per_line
+				),
+				.next_pixel_offset = -bytes_per_pixel,
+				.next_line_offset = -bytes_per_line
+			};
+		case FB_ROTATE_CCW:
+			// Bottom left corner is (yres-1 lines, 0 pixels).
+			// x offset translates to a negative offset in lines.
+			// y offset translates to a positive offset in pixels.
+			return (struct screen_draw_info) {
+				.start_position = (
+					(resolution_y - 1)*bytes_per_line +
+					0*bytes_per_pixel +
+					-offset_x*bytes_per_line +
+					offset_y*bytes_per_pixel
+				),
+				.next_pixel_offset = -bytes_per_line,
+				.next_line_offset = bytes_per_pixel
+			};
+		case FB_ROTATE_UR:
+		default:
+			// Top left corner is (0 lines, 0 pixels).
+			// x offset translates to a positive offset in pixels.
+			// y offset translates to a positive offset in lines.
+			return (struct screen_draw_info) {
+				.start_position = (
+					0*bytes_per_line +
+					0*bytes_per_pixel +
+					offset_x*bytes_per_pixel +
+					offset_y*bytes_per_line
+				),
+				.next_pixel_offset = bytes_per_pixel,
+				.next_line_offset = bytes_per_line
+			};
+	}
+
+}
+
+// Fill destination from source
+// This does double duty to fill a region of the screen
+// both with a color and the background image, depending
+// on the source_info; to fill with an unchanging color,
+// you'd pass a zeroed struct for source_info, otherwise
+// you'd pass an image buffer and the info necessary tož
+// walk along it.
+static inline void fbcondecor_fill_block(
+	u8 *destination, struct screen_draw_info destination_info,
+	u8 *source, struct screen_draw_info source_info,
+	int area_height, int area_width
+) {
+
+	destination += destination_info.start_position;
+	source += source_info.start_position;
+
+	while (area_height-- > 0) {
+		u8 *destination_line = destination;
+		u8 *source_line = source;
+
+		for (int i = 0; i < area_width; i++) {
+			fb_writel(*(u32*)source_line, (u32*)destination_line);
+			source_line += source_info.next_pixel_offset;
+			destination_line += destination_info.next_pixel_offset;
+		}
+
+		source += source_info.next_line_offset;
+		destination += destination_info.next_line_offset;
+	}
+}
+
+// Fill destination from source or a color, depending on
+// whether a mask (character) is high or low. This is used
+// to render a character, and does similar double duty with
+// regards to source_info like fbcondecor_fill_block
+static inline void fbcondecor_fill_character(
+	u8 *destination, struct screen_draw_info destination_info,
+	u8 *source, struct screen_draw_info source_info,
+	u8* character, int character_height, int character_width,
+	u32 foreground_color
+) {
+	destination += destination_info.start_position;
+	source += source_info.start_position;
+
+	u8 current_character_part;
+	while (character_height-- > 0) {
+		u8 *destination_line = destination;
+		u8 *source_line = source;
+
+		for (int i = 0; i < character_width; i++) {
+			if ((i & 7) == 0)
+				current_character_part = *character++;
+			fb_writel(
+				(
+					(current_character_part & 0b10000000) ?
+					foreground_color :
+					*(u32 *) source_line
+				),
+				(u32*) destination_line
+			);
+			current_character_part <<= 1;
+			source_line += source_info.next_pixel_offset;
+			destination_line += destination_info.next_pixel_offset;
+		}
+
+		source += source_info.next_line_offset;
+		destination += destination_info.next_line_offset;
+	}
+
+}
+
+static void fbcondecor_fill(
+	struct fb_info *info, struct vc_data *vc,
+	int offset_y, int offset_x,
+	int height, int width, int color_index
+) {
+	if (!fbcondecor_initialized_state) return;
+	struct screen_draw_info destination_draw_info = get_draw_info(
+		info->fbcon_par->rotate,
+		info->var.xres, info->var.yres,
+		offset_x, offset_y,
+		4, info->fix.line_length
+	);
+
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+	u32 background_color = fbcondecor_get_color(info, color_index);
+	struct screen_draw_info source_draw_info = {0};
+	u8* source = (u8*) &background_color;
+
+	if (
+		!info->fbcon_par->blank_state &&
+		color_index == vc_background_color_index &&
+		vc->vc_fbcondecor_image
+	) {
+		int image_line_length = FBCON_SWAP(
+			info->fbcon_par->rotate,
+			4*info->var.xres,
+			4*info->var.yres
+		);
+		source = vc->vc_fbcondecor_image;
+		// We always read the source as if it were upright.
+		// This is to make the background image orient itself
+		// the same way the console is oriented.
+		source_draw_info = get_draw_info(
+			FB_ROTATE_UR,
+			// These 2 don't matter for upright.
+			0, 0,
+			offset_x, offset_y,
+			4, image_line_length
+		);
+	}
+
+	fbcondecor_fill_block(
+		info->screen_base, destination_draw_info,
+		source, source_draw_info,
+		height, width
+	);
+}
+
+
+void fbcondecor_putcs(
+	struct vc_data *vc, struct fb_info *info,
+	const u16 *character_source, int character_count,
+	int row, int column,
+	int foreground_color_index,
+	int background_color_index
+) {
+	if (!fbcondecor_initialized_state) return;
+	u16 charmask = vc->vc_hi_font_mask ? 0x1ff : 0xff;
+	u32 background_color = fbcondecor_get_color(
+		info, background_color_index
+	);
+	u32 foreground_color = fbcondecor_get_color(
+		info, foreground_color_index
+	);
+	u16 character;
+	u8 *character_data;
+	
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+	
+	int offset_x = column * vc->vc_font.width + fbcondecor_offset_x(vc);
+	int offset_y = row * vc->vc_font.height + fbcondecor_offset_y(vc);
+	
+	struct screen_draw_info destination_draw_info = get_draw_info(
+		info->fbcon_par->rotate,
+		info->var.xres, info->var.yres,
+		offset_x, offset_y,
+		4, info->fix.line_length
+	);
+	
+	struct screen_draw_info source_draw_info = {0};
+	u8* source = (u8*) &background_color;
+	if (
+		!info->fbcon_par->blank_state &&
+		background_color_index == vc_background_color_index &&
+		vc->vc_fbcondecor_image
+	) {
+		int image_line_length = FBCON_SWAP(
+			info->fbcon_par->rotate,
+			4*info->var.xres,
+			4*info->var.yres
+		);
+		source = vc->vc_fbcondecor_image;
+		// We always read the source as if it were upright.
+		// This is to make the background image orient itself
+		// the same way the console is oriented.
+		source_draw_info = get_draw_info(
+			FB_ROTATE_UR,
+			// These 2 don't matter for upright.
+			0, 0,
+			offset_x, offset_y,
+			4, image_line_length
+		);
+	}
+	
+	while (character_count--) {
+		character = scr_readw(character_source++);
+		character_data = vc->vc_font.data + (character & charmask) *
+		                 vc->vc_font.height *
+		                 ((vc->vc_font.width + 7) >> 3);
+		fbcondecor_fill_character(
+			info->screen_base, destination_draw_info,
+			source, source_draw_info,
+			character_data, vc->vc_font.height, vc->vc_font.width,
+			foreground_color
+		);
+		destination_draw_info.start_position += (
+			destination_draw_info.next_pixel_offset *
+			vc->vc_font.width
+		);
+		source_draw_info.start_position += (
+			source_draw_info.next_pixel_offset *
+			vc->vc_font.width
+		);
+	}
+}
+
+void fbcondecor_cursor(struct fb_info *info, struct fb_cursor *cursor) {
+	if (!fbcondecor_initialized_state) return;
+	int i;
+	unsigned int dsize, s_pitch;
+	struct fbcon_par *ops = info->fbcon_par;
+	struct vc_data *vc;
+
+	// We don't need any cursors while the console is blanked.
+	if (info->state != FBINFO_STATE_RUNNING || ops->blank_state)
+		return;
+
+	vc = vc_cons[ops->currcon].d;
+
+	s_pitch = (cursor->image.width + 7) >> 3;
+	dsize = s_pitch * cursor->image.height;
+	u8* character_data = kmalloc(dsize, GFP_ATOMIC);
+	if (!character_data)
+		return;
+
+	if (cursor->enable) {
+		switch (cursor->rop) {
+		case ROP_XOR:
+			for (i = 0; i < dsize; i++)
+				character_data[i] = (
+					cursor->image.data[i] ^ cursor->mask[i]
+				);
+			break;
+		case ROP_COPY:
+		default:
+			for (i = 0; i < dsize; i++)
+				character_data[i] = (
+					cursor->image.data[i] & cursor->mask[i]
+				);
+			break;
+		}
+	} else
+		memcpy(character_data, cursor->image.data, dsize);
+	
+	int vc_background_color_index = (vc->vc_def_color >> 4) & 0xf;
+	
+	struct screen_draw_info destination_draw_info = get_draw_info(
+		info->fbcon_par->rotate,
+		info->var.xres, info->var.yres,
+		cursor->image.dx + fbcondecor_offset_x(vc),
+		cursor->image.dy + fbcondecor_offset_y(vc),
+		4, info->fix.line_length
+	);
+	
+	struct screen_draw_info source_draw_info = {0};
+	u32 background_color = fbcondecor_get_color(
+		info, cursor->image.bg_color
+	);
+	u8* source = (u8*) &background_color;
+	if (
+		cursor->image.bg_color == vc_background_color_index &&
+		vc->vc_fbcondecor_image
+	) {
+		int image_line_length = FBCON_SWAP(
+			info->fbcon_par->rotate,
+			4*info->var.xres,
+			4*info->var.yres
+		);
+		source = vc->vc_fbcondecor_image;
+		// We always read the source as if it were upright.
+		// This is to make the background image orient itself
+		// the same way the console is oriented.
+		source_draw_info = get_draw_info(
+			FB_ROTATE_UR,
+			// NOTE: These 2 don't matter for upright
+			0, 0,
+			cursor->image.dx + fbcondecor_offset_x(vc),
+			cursor->image.dy + fbcondecor_offset_y(vc),
+			4, image_line_length
+		);
+	}
+
+
+	fbcondecor_fill_character(
+		info->screen_base, destination_draw_info,
+		source, source_draw_info,
+		character_data, cursor->image.height, cursor->image.width,
+		fbcondecor_get_color(info, cursor->image.fg_color)
+	);
+
+	kfree(character_data);
+}
+
+
+void fbcondecor_clear(
+	struct vc_data *vc, struct fb_info *info,
+	int start_row, int start_column,
+	int span_rows, int span_columns,
+	int foreground_color_index, int background_color_index
+) {
+	if (!fbcondecor_initialized_state) return;
+
+	int offset_y = start_row*vc->vc_font.height + fbcondecor_offset_y(vc);
+	int offset_x = (
+		start_column*vc->vc_font.width + fbcondecor_offset_x(vc);
+	)
+
+	int height = span_rows * vc->vc_font.height;
+	int width = span_columns * vc->vc_font.width;
+
+	fbcondecor_fill(info, vc,
+	                offset_y, offset_x,
+	                height, width, background_color_index);
+}
+
+void fbcondecor_clear_margins(struct vc_data *vc, struct fb_info *info,
+                              int color_index, int bottom_only)
+{
+	if (!fbcondecor_initialized_state) return;
+
+	int xres = FBCON_SWAP(
+		info->fbcon_par->rotate, info->var.xres, info->var.yres
+	);
+	int yres = FBCON_SWAP(
+		info->fbcon_par->rotate, info->var.yres, info->var.xres
+	);
+
+	unsigned int vc_width = vc->vc_cols*vc->vc_font.width;
+	unsigned int vc_height = vc->vc_rows*vc->vc_font.height;
+
+	if (!bottom_only) {
+		// Top margin
+		fbcondecor_fill(
+			info, vc,
+			0, 0,
+			fbcondecor_offset_y(vc), xres,
+			color_index
+		);
+		// Left margin
+		fbcondecor_fill(
+			info, vc,
+			fbcondecor_offset_y(vc), 0,
+			vc_height, fbcondecor_offset_x(vc),
+			color_index
+		);
+		// Right margin
+		fbcondecor_fill(
+			info, vc,
+			fbcondecor_offset_y(vc),
+			fbcondecor_offset_x(vc) + vc_width,
+			vc_height,
+			xres - fbcondecor_offset_x(vc) - vc_width,
+			color_index
+		);
+	}
+	// Bottom margin
+	fbcondecor_fill(
+		info, vc,
+		fbcondecor_offset_y(vc) + vc_height, 0,
+		yres - fbcondecor_offset_y(vc) - vc_height, xres,
+		color_index
+	);
+}
+
+void fbcondecor_bmove_redraw(struct vc_data *vc, struct fb_info *info, int y,
+                             int source_x, int destination_x, int width)
+{
+	if (!fbcondecor_initialized_state) return;
+	u16 *destination = (u16 *) (
+		vc->vc_origin + vc->vc_size_row*y + destination_x*2
+	);
+	u16 *source = destination + (destination_x - source_x);
+	u16 *current_run = destination;
+
+	u16 *line_start = destination;
+	u16 *line_end = destination + width;
+	u16 character;
+	int current_x = destination_x;
+
+	u16 current_attribute = 1;
+	u16 attrmask = vc->vc_hi_font_mask ? 0xfe00 : 0xff00;
+
+	int bgshift = (vc->vc_hi_font_mask) ? 13 : 12;
+	int fgshift = (vc->vc_hi_font_mask) ? 9 : 8;
+
+	do {
+		character = scr_readw(destination);
+		// We send only runs of characters with the same attributes to
+		// putcs.
+		if (current_attribute != (character & attrmask)) {
+			int foreground_color_index = attr_fgcol(
+				fgshift, current_attribute
+			);
+			int background_color_index = attr_bgcol(
+				bgshift, current_attribute
+			);
+			current_attribute = character & attrmask;
+			if (destination > current_run) {
+
+				fbcondecor_putcs(
+					vc, info, current_run,
+					destination - current_run, y,
+					current_x,
+					foreground_color_index,
+					background_color_index
+				);
+				current_x += destination - current_run;
+				current_run = destination;
+			}
+		}
+		// If a character would have been the same anyway,
+		// we don't change it.
+		if (
+			source >= line_start &&
+			source < line_end &&
+			character == scr_readw(source)
+		) {
+			int foreground_color_index = attr_fgcol(
+				fgshift, current_attribute
+			);
+			int background_color_index = attr_bgcol(
+				bgshift, current_attribute
+			);
+			if (destination > current_run) {
+				fbcondecor_putcs(
+					vc, info, current_run,
+					destination - current_run, y,
+					current_x,
+					foreground_color_index,
+					background_color_index
+				);
+				current_x += destination - current_run + 1;
+				current_run = destination + 1;
+			} else {
+				current_x++;
+				current_run++;
+			}
+		}
+		source++;
+		destination++;
+	} while (destination < line_end);
+	if (destination > current_run) {
+		int foreground_color_index = attr_fgcol(
+			fgshift, current_attribute
+		);
+		int background_color_index = attr_bgcol(
+			bgshift, current_attribute
+		);
+		fbcondecor_putcs(
+			vc, info, current_run,
+			destination - current_run, y, current_x,
+			foreground_color_index, background_color_index
+		);
+	}
+}
