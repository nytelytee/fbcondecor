+/*
+ *  linux/drivers/video/console/fbcondecor.h -- Framebuffer Console Decoration headers
+ *
+ *  Copyright (C) 2004 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *  Copyright (C) 2026-2026 NyteLyte <nytelyte@tuta.io>
+ *
+ */
+
+#ifndef __FBCONDECOR_H
+#define __FBCONDECOR_H
+
+struct fb_cursor;
+struct fb_info;
+
+#include <linux/kd.h>
+#include <linux/tty_port.h>
+#include <linux/console_struct.h>
+
+#ifdef CONFIG_FBCONDECOR
+
+/* fbcondecor.c */
+void fbcondecor_reset(void);
+int fbcondecor_init(void);
+
+/* cfbcondecor.c */
+// TODO: Since these are actually low-level rendering functions, maybe their "hooks" should all actually be moved into bitblit.c/similar files.
+//       The original patch just put them inside of fbcon.c (and one hook into bitblit.c iirc). Changing this may require big rearchitecturing
+//       of the patch, so I will leave this for "later" (read: probably never). I also don't really know how this handles virtual resolutions,
+//       if the kernel crashes or something, it is probably a thing that I should try to fix, but I don't entirely understand how the section
+//       of kernel code that this patch touches works.
+void fbcondecor_putcs(struct vc_data *vc, struct fb_info *info, const unsigned short *s, int count, int yy, int xx);
+void fbcondecor_cursor(struct fb_info *info, struct fb_cursor *cursor);
+void fbcondecor_clear(struct vc_data *vc, struct fb_info *info, int sy, int sx, int height, int width);
+void fbcondecor_clear_margins(struct vc_data *vc, struct fb_info *info, int bottom_only);
+void fbcondecor_blank(struct vc_data *vc, struct fb_info *info, int blank);
+void fbcondecor_bmove_redraw(struct vc_data *vc, struct fb_info *info, int y, int sx, int dx, int width);
+
+extern bool fbcondecor_initialized_state;
+
+static inline bool fbcondecor_active(struct fb_info *info, struct vc_data* vc) {
+	return (
+		fbcondecor_initialized_state &&
+		(vc->vc_fbcondecor_geometry || vc->vc_fbcondecor_image) &&
+		info->fix.visual == FB_VISUAL_TRUECOLOR &&
+		info->var.bits_per_pixel == 32
+	);
+}
+
+#else /* CONFIG_FBCONDECOR */
+
+/* fbcondecor.c */
+static inline int fbcondecor_init(void) { return 0; }
+static inline void fbcondecor_reset(void) {}
+
+/* cfbcondecor.c */
+static inline void fbcondecor_putcs(struct vc_data *vc, struct fb_info *info, const unsigned short *s, int count, int yy, int xx) {}
+static inline void fbcondecor_cursor(struct fb_info *info, struct fb_cursor *cursor) {}
+static inline void fbcondecor_clear(struct vc_data *vc, struct fb_info *info, int sy, int sx, int height, int width) {}
+static inline void fbcondecor_clear_margins(struct vc_data *vc, struct fb_info *info, int bottom_only) {}
+static inline void fbcondecor_blank(struct vc_data *vc, struct fb_info *info, int blank) {}
+static inline void fbcondecor_bmove_redraw(struct vc_data *vc, struct fb_info *info, int y, int sx, int dx, int width) {}
+
+#define fbcondecor_active(x, y) (0)
+
+#endif /* CONFIG_FBCONDECOR */
+
+#endif /* __FBCONDECOR_H */
