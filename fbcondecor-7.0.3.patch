diff -ruN oldlinux/drivers/video/fbdev/core/fbcondecor.c newlinux/drivers/video/fbdev/core/fbcondecor.c
--- oldlinux/drivers/video/fbdev/core/fbcondecor.c	1970-01-01 01:00:00.000000000 +0100
+++ newlinux/drivers/video/fbdev/core/fbcondecor.c	2026-05-11 02:21:56.666040418 +0200
@@ -0,0 +1,336 @@
+/*
+ *  linux/drivers/video/fbdev/core/fbcondecor.c -- Framebuffer console
+ *                                                 decorations
+ *
+ *  Copyright (C) 2004-2009 Michal Januszewski <michalj+fbcondecor@gmail.com>
+ *  Copyright (C) 2026-2026 NyteLyte <nytelyte@tuta.io>
+ *
+ *  Original code based upon "Bootsplash" (C) 2001-2003
+ *       Volker Poplawski <volker@poplawski.de>,
+ *       Stefan Reinauer <stepan@suse.de>,
+ *       Steffen Winterfeldt <snwint@suse.de>,
+ *       Michael Schroeder <mls@suse.de>,
+ *       Ken Wimer <wimer@suse.de>.
+ *
+ *  Original compat ioctl support by Thorsten Klein <TK@Thorsten-Klein.de>.
+ *
+ *  This file is subject to the terms and conditions of the GNU General Public
+ *  License.  See the file COPYING in the main directory of this archive for
+ *  more details.
+ *
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/fb.h>
+#include <linux/vt_kern.h>
+#include <linux/vmalloc.h>
+#include <linux/unistd.h>
+#include <linux/syscalls.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+#include <linux/workqueue.h>
+#include <linux/kmod.h>
+#include <linux/miscdevice.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/compat.h>
+#include <linux/console.h>
+#include <linux/binfmts.h>
+#include <linux/uaccess.h>
+#include <asm/irq.h>
+
+#include "fbcon.h"
+#include "fbcondecor.h"
+
+bool fbcondecor_initialized_state = false;
+
+static int fbcondecor_ioctl_func(
+	struct vc_data *vc,
+	u16 command_flag,
+	struct fbcondecor_geometry __user *user_get_geometry /* out */,
+	u8 __user *user_get_image /* out */,
+	const struct fbcondecor_geometry __user *user_set_geometry /* in */,
+	const u8 __user *user_set_image /* in */
+) {
+
+	struct fb_info *info = fbcon_info_from_console(vc->vc_num);
+
+	size_t image_size;
+	if (check_mul_overflow(info->var.xres, info->var.yres, &image_size)) {
+		printk(
+			KERN_ERR
+			"fbcondecor: framebuffer resolution too large\n"
+		);
+		return -EINVAL;
+	}
+	if (check_mul_overflow(image_size, (size_t) 4, &image_size)) {
+		printk(
+			KERN_ERR
+			"fbcondecor: framebuffer resolution too large\n"
+		);
+		return -EINVAL;
+	}
+
+	if (
+		command_flag &
+		FBCONDECOR_FLAG_GET_GEOMETRY && !user_get_geometry
+	) {
+		printk(
+			KERN_ERR
+			"fbcondecor: unable to copy "
+			"geometry to userspace\n"
+		);
+		return -EINVAL;
+	} 
+	if (command_flag & FBCONDECOR_FLAG_GET_IMAGE && !user_get_image) {
+		printk(
+			KERN_ERR
+			"fbcondecor: unable to copy "
+			"image to userspace\n"
+		);
+		return -EINVAL;
+	}
+	struct fbcondecor_geometry *old_geometry = vc->vc_fbcondecor_geometry;
+	u8 *old_image = vc->vc_fbcondecor_image;
+	u16 previous_state = old_geometry ? FBCONDECOR_STATE_GEOMETRY : 0;
+	previous_state |= old_image ? FBCONDECOR_STATE_IMAGE : 0;
+
+	struct fbcondecor_geometry *new_geometry = NULL;
+	u8 *new_image = NULL;
+
+	
+	if (command_flag & FBCONDECOR_FLAG_SET_GEOMETRY && user_set_geometry) {
+		new_geometry = kmalloc(
+			sizeof(struct fbcondecor_geometry),
+			GFP_KERNEL
+		);
+		int col_resolution = FBCON_SWAP(
+			info->fbcon_par->rotate, info->var.xres, info->var.yres
+		);
+		int row_resolution = FBCON_SWAP(
+			info->fbcon_par->rotate, info->var.yres, info->var.xres
+		);
+		if (!new_geometry) return -ENOMEM;
+		if (copy_from_user(
+			new_geometry,
+			user_set_geometry,
+			sizeof(struct fbcondecor_geometry)
+		)) {
+			printk(
+				KERN_ERR
+				"fbcondecor: unable to copy "
+				"geometry from userspace\n"
+			);
+			kfree(new_geometry);
+			return -EFAULT;
+		}
+		if (
+			!new_geometry->width ||
+			!new_geometry->height ||
+			(
+				new_geometry->offset_x +
+				new_geometry->width > col_resolution
+			) ||
+			(
+				new_geometry->offset_y +
+				new_geometry->height > row_resolution
+			)
+		) {
+			printk(
+				KERN_ERR
+				"fbcondecor: invalid geometry passed "
+				"from userspace\n"
+			);
+			kfree(new_geometry);
+			return -EINVAL;
+		}
+	}
+
+	if (command_flag & FBCONDECOR_FLAG_SET_IMAGE && user_set_image) {
+		new_image = vmalloc(image_size);
+		if (!new_image) {
+			if (new_geometry) kfree(new_geometry);
+			return -ENOMEM;
+		}
+		if (copy_from_user(new_image, user_set_image, image_size)) {
+			printk(
+				KERN_ERR
+				"fbcondecor: unable to copy image "
+				"from userspace\n"
+			);
+			if (new_geometry) kfree(new_geometry);
+			vfree(new_image);
+			return -EFAULT;
+		}
+	}
+	
+	if (old_geometry && command_flag & FBCONDECOR_FLAG_GET_GEOMETRY) {
+		if (copy_to_user(
+			user_get_geometry,
+			old_geometry,
+			sizeof(struct fbcondecor_geometry)
+		)) {
+			printk(
+				KERN_ERR
+				"fbcondecor: unable to copy geometry "
+				"to userspace\n"
+			);
+			if (new_geometry) kfree(new_geometry);
+			if (new_image) vfree(new_image);
+			return -EFAULT;
+		}
+	}
+
+	if (old_image && command_flag & FBCONDECOR_FLAG_GET_IMAGE) {
+		if(copy_to_user(user_get_image, old_image, image_size)) {
+			printk(
+				KERN_ERR
+				"fbcondecor: unable to copy "
+				"image to userspace\n"
+			);
+			if (new_geometry) kfree(new_geometry);
+			if (new_image) vfree(new_image);
+			return -EFAULT;
+		}
+	}
+	
+	bool redraw = false;
+	if (command_flag & FBCONDECOR_FLAG_SET_GEOMETRY) {
+		redraw = true;
+		if (old_geometry) kfree(old_geometry);
+		vc->vc_fbcondecor_geometry = new_geometry;
+		u32 cols, rows;
+		if (vc->vc_fbcondecor_geometry) {
+			cols = vc->vc_fbcondecor_geometry->width;
+			rows = vc->vc_fbcondecor_geometry->height;
+		} else {
+			cols = FBCON_SWAP(
+				info->fbcon_par->rotate,
+				info->var.xres, info->var.yres
+			);
+			rows = FBCON_SWAP(
+				info->fbcon_par->rotate,
+				info->var.yres, info->var.xres
+			);
+		}
+		cols /= vc->vc_font.width;
+		rows /= vc->vc_font.height;
+		vc_resize(vc, cols, rows);
+	}
+
+	if (command_flag & FBCONDECOR_FLAG_SET_IMAGE) {
+		redraw = true;
+		if (old_image) vfree(old_image);
+		vc->vc_fbcondecor_image = new_image;
+	}
+
+
+	if (fg_console == vc->vc_num && redraw) {
+		redraw_screen(vc, 0);
+		update_region(
+			vc, vc->vc_origin +
+			vc->vc_size_row * vc->vc_top,
+			vc->vc_size_row * (vc->vc_bottom - vc->vc_top) / 2
+		);
+		fbcon_clear_margins(vc, 0);
+	}
+
+
+	return previous_state;
+}
+
+static long fbcondecor_ioctl(struct file *filp, u_int cmd, u_long arg)
+{
+	if (!fbcondecor_initialized_state) return -EINVAL;
+
+	struct vc_data *vc = NULL;
+	
+	struct fbcondecor_command command;
+	struct fbcondecor_command __user *wrapper = u64_to_user_ptr((u64) arg);
+	if (copy_from_user(&command, wrapper, sizeof(command))) {
+		printk(
+			KERN_ERR
+			"fbcondecor: unable to copy command from userspace\n"
+		);
+		return -EFAULT;
+	}
+	if (command.pad != 0) {
+		printk(
+			KERN_ERR
+			"fbcondecor: invalid command, padding is not 0\n"
+		);
+		return -EINVAL;
+	}
+	if (!vc_cons_allocated(command.vc)) {
+		printk(
+			KERN_ERR
+			"fbcondecor: invalid command, console "
+			"is not allocated\n"
+		);
+		return -EINVAL;
+	}
+	vc = vc_cons[command.vc].d;
+
+	if (cmd != FBIO_CONDECOR) return -ENOIOCTLCMD;
+
+	console_lock();
+	int result = fbcondecor_ioctl_func(
+		vc,
+		command.flag,
+		u64_to_user_ptr(command.get_geometry),
+		u64_to_user_ptr(command.get_image),
+		u64_to_user_ptr(command.set_geometry),
+		u64_to_user_ptr(command.set_image)
+	);
+	console_unlock();
+	return result;
+}
+
+static struct file_operations fbcondecor_ops = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = fbcondecor_ioctl,
+	.compat_ioctl = compat_ptr_ioctl
+};
+
+static struct miscdevice fbcondecor_dev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "fbcondecor",
+	.fops = &fbcondecor_ops
+};
+
+void fbcondecor_reset(void)
+{
+	if (!fbcondecor_initialized_state) return;
+
+	for (int i = 0; i < MAX_NR_CONSOLES && vc_cons[i].d; i++) {
+		if (vc_cons[i].d == NULL) continue;
+		if (vc_cons[i].d->vc_fbcondecor_geometry) {
+			kfree(vc_cons[i].d->vc_fbcondecor_geometry);
+			vc_cons[i].d->vc_fbcondecor_geometry = NULL;
+		}
+		if (vc_cons[i].d->vc_fbcondecor_image) {
+			vfree(vc_cons[i].d->vc_fbcondecor_image);
+			vc_cons[i].d->vc_fbcondecor_image = NULL;
+		}
+	}
+}
+
+int fbcondecor_init(void)
+{
+	if (fbcondecor_initialized_state) return 0;
+	fbcondecor_initialized_state = true;
+	
+	int i;
+
+	fbcondecor_reset();
+
+	i = misc_register(&fbcondecor_dev);
+	if (i) {
+		printk(KERN_ERR "fbcondecor: failed to register device\n");
+		return i;
+	}
+
+	return 0;
+}
